# Edge Add-ons 发布 API 凭据
# 复制为 .env（已在 .gitignore 中，切勿提交真实值）；CI 改为仓库 secrets。

# Partner Center → Microsoft Edge → 扩展概览页的 Product ID（GUID）
EDGE_PRODUCT_ID=

# Publish API 页面点击「Create API credentials」生成的 Client ID 与 API Key
EDGE_CLIENT_ID=
EDGE_API_KEY=

# v1 令牌模式（可选）：没有 API Key 时改用 Azure AD 应用的客户端凭据
# EDGE_TENANT_ID=
# EDGE_CLIENT_SECRET=

# 提审备注（可选）；不填时默认为 "Leafmark {版本}"
# EDGE_NOTES=
